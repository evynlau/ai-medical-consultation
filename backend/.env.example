# ====== 应用 ======
APP_NAME="AI 智能问诊系统"
APP_VERSION="1.0.0"
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ====== 数据库 ======
# 默认 SQLite,生产可换 PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./data/medical.db

# ====== Redis (可选,留空则不启用) ======
REDIS_URL=

# ====== JWT ======
SECRET_KEY=please-change-this-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ====== LLM ======================
# mock   : 内置规则引擎,无需任何服务,适合先跑通流程
# ollama : 本地 Ollama(自动用 http://localhost:11434/v1)
# openai : OpenAI 兼容服务(通义千问/智谱/deepseek 等)
LLM_PROVIDER=mock

# --- Ollama 配置(LLM_PROVIDER=ollama 时生效) ---
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
# 模型名必须 ollama list 中存在
# 推荐:
#   gemma4:e2b            7GB  快,非思考型,推荐(默认)
#   glm-4.7-flash:latest  19GB 中文好,速度快
#   qwen3.6:27b-q4_K_M   17GB 中文医学能力强
# 避免思考型 MoE(qwen3.6:35b-a3b 等),它们有时只输出 reasoning 不输出 content
OPENAI_MODEL=gemma4:e2b

# --- OpenAI 兼容服务配置(LLM_PROVIDER=openai 时生效) ---
# OPENAI_API_KEY=sk-你的key
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen-plus

# ====== Embedding ======
# mock   : 基于字符的简易向量,无需联网(默认,推荐本地演示)
# local  : sentence-transformers 本地模型(需首次下载)
# openai : OpenAI text-embedding-3-small
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# ====== RAG ======
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.2

# ====== CORS ======
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
