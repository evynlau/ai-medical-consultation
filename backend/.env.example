# ====== 应用 ======
APP_NAME="AI 智能问诊系统"
APP_VERSION="1.0.0"
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ====== 数据库 ======
# 默认 SQLite,生产可换 PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./data/medical.db

# ====== Redis (可选,留空则不启用) ======
REDIS_URL=

# ====== JWT ======
SECRET_KEY=please-change-this-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ====== LLM ======================
# mock   : 内置规则引擎,无需任何服务,适合先跑通流程
# ollama : 本地 Ollama(自动用 http://localhost:11434/v1)
# openai : OpenAI 兼容服务(通义千问/智谱/deepseek 等)
LLM_PROVIDER=mock

# --- Ollama 配置(LLM_PROVIDER=ollama 时生效) ---
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
# 模型名必须 ollama list 中存在
# 推荐:
#   gemma4:e2b            7GB  快,非思考型,推荐(默认)
#   glm-4.7-flash:latest  19GB 中文好,速度快
#   qwen3.6:27b-q4_K_M   17GB 中文医学能力强
# 避免思考型 MoE(qwen3.6:35b-a3b 等),它们有时只输出 reasoning 不输出 content
OPENAI_MODEL=gemma4:e2b

# --- OpenAI 兼容服务配置(LLM_PROVIDER=openai 时生效) ---
# OPENAI_API_KEY=sk-你的key
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen-plus

# ====== OCR 引擎 ======================
# auto      : 按可用性自动选 vision > tesseract > mock
# vision    : 多模态 LLM 直接读图(推荐!Ollama 跑 llama3.2-vision / qwen2-vl)
# tesseract : 本地 tesseract-ocr(需装系统包,无 LLM 也能用)
# mock      : 永远返回演示文本(用于接口联调)
OCR_ENGINE=auto

# OCR 专用 vision 模型(留空跟随 LLM 的 OPENAI_MODEL)
# Ollama 示例: llama3.2-vision / qwen2-vl:7b / llava
# OpenAI: gpt-4-vision-preview
# OCR_VISION_MODEL=llama3.2-vision

# ====== 影像内容验证(防误传) ======================
# 上传胸片前用 PSPNet 肺部分割验证是否真是胸片(完全本地、不依赖视觉 LLM)
# auto / true / 1 / on : 默认启用(PSPNet 已随 xrv 加载)
# false / 0 / off    : 禁用(完全信任 xrv 模型输出)
IMAGING_VALIDATION=auto

# 仅当您同时安装了多模态 LLM(如 llama3.2-vision / qwen2-vl)且想加强验证时,
# 可在 validation.py 里启用 validate_chest_xray() 的 LLM 二次验证
# IMAGING_VALIDATION_MODEL=qwen2-vl:2b

# ====== Embedding ======
# mock   : 基于字符的简易向量,无需联网(默认,推荐本地演示)
# local  : sentence-transformers 本地模型(需首次下载)
# openai : OpenAI text-embedding-3-small
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
# Embedding 独立 base_url/api_key(留空回退到 OPENAI_BASE_URL/OPENAI_API_KEY)
# 推荐把 embedding 切到本地 ollama 的 nomic-embed-text(免费、768 维、中英文均可)
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_API_KEY=ollama

# ====== RAG ======
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.2

# 单次重建索引允许的最大耗时(秒)。默认 86400=24 小时,
# 实际视为"不限制",知识库持续增长也不会中断。
# 想要快速失败重试可以调小,例如 600=10 分钟。
# EMBED_TIMEOUT=86400

# ====== CORS ======
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
